MAILTRAP_PORT=2525
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=

THROTTLE_TTL=60000
THROTTLE_LIMIT=10

AVATAR_CDN_BASE_URL=http://localhost:3000/uploads
