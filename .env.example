NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/eatwise

JWT_ACCESS_SECRET=your-access-secret-here
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=your-refresh-secret-here
