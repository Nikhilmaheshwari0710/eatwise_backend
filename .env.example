GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

MAILTRAP_API_TOKEN=
